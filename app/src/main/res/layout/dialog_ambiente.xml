<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Servidor"
        android:textColor="@color/on_bg"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Escolha onde o app se conecta"
        android:textColor="@color/on_bg_muted"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/grupoAmbiente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <RadioButton
            android:id="@+id/optCasa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Em casa (rede local)"
            android:textColor="@color/on_bg"
            android:buttonTint="@color/focus"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/optTailscale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tailscale"
            android:textColor="@color/on_bg"
            android:buttonTint="@color/focus"
            android:paddingVertical="6dp" />

        <RadioButton
            android:id="@+id/optOnline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Online"
            android:textColor="@color/on_bg"
            android:buttonTint="@color/focus"
            android:paddingVertical="6dp" />
    </RadioGroup>

    <EditText
        android:id="@+id/campoEndereco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Endereço do servidor"
        android:textColor="@color/on_bg"
        android:textColorHint="@color/on_bg_muted"
        android:inputType="textUri"
        android:padding="14dp"
        android:background="@drawable/campo_bg" />

    <TextView
        android:id="@+id/statusTeste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/on_bg_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnTestar"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Testar"
            android:textColor="@color/focus" />

        <Button
            android:id="@+id/btnSalvarAmbiente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Salvar"
            android:textColor="@color/on_focus"
            android:backgroundTint="@color/focus" />
    </LinearLayout>

</LinearLayout>